<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext (HTTP) must stay permitted: third-party extensions and internet radio
      stations (e.g. Radio Browser) frequently serve audio streams over plain HTTP.
      Blocking it makes songs/stations fail to load or play.
      HTTPS is still used automatically wherever the source supports it.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
