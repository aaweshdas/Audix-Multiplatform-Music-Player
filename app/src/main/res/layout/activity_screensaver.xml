<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screensaverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D"
    android:fitsSystemWindows="false"
    android:keepScreenOn="true">

    <!-- 1. FULLSCREEN 3D ALBUM MOSAIC WALLPAPER -->
    <ImageView
        android:id="@+id/ivScreensaverBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/screensaver_bg"
        android:importantForAccessibility="no" />

    <!-- Ambient Dark Vignette Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <!-- Top Floating Exit Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCloseScreensaver"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#99101422"
        app:cardCornerRadius="19dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_close"
            app:tint="@color/audix_white"
            android:importantForAccessibility="no" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. UNIFIED FROSTED NOW PLAYING CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScreensaverMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="#F2111422"
        app:cardCornerRadius="30dp"
        app:cardElevation="22dp"
        app:strokeColor="#38FFFFFF"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- Square Album Artwork Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLiveArtwork"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:cardBackgroundColor="#0A0C12"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="#25FFFFFF"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/ivScreensaverCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_music"
                        android:importantForAccessibility="no" />
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Song Info & Studio Equalizer Shortcut -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/btnScreensaverAirplay"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeviceSpec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIGHTLY • STUDIO SOUNDSTAGE"
                        android:textColor="@color/audix_cyan_bright"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvScreensaverTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@color/audix_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        tools:text="Tum Hi Ho" />

                    <TextView
                        android:id="@+id/tvScreensaverArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/audix_text_secondary"
                        android:textSize="12.5sp"
                        tools:text="Arijit Singh, Mithoon • Aashiqui 2" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnScreensaverAirplay"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_airplay"
                    app:tint="@color/audix_white"
                    android:importantForAccessibility="no" />
            </RelativeLayout>

            <!-- Scrubber Seekbar with Live Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-12dp"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    app:thumbColor="@color/audix_white"
                    app:thumbRadius="5dp"
                    app:trackColorActive="@color/audix_white"
                    app:trackColorInactive="#40FFFFFF"
                    app:trackHeight="3.5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/audix_text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTotalDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-0:00"
                        android:textColor="@color/audix_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Playback Transport Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Previous -->
                <ImageView
                    android:id="@+id/btnPrevious"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="22dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@drawable/ic_skip_previous_40dp"
                    app:tint="@color/audix_white"
                    android:importantForAccessibility="no" />

                <!-- Play / Pause -->
                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_pause_to_play_48dp_anim"
                    app:tint="@color/audix_white"
                    android:importantForAccessibility="no" />

                <!-- Next -->
                <ImageView
                    android:id="@+id/btnNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="22dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@drawable/ic_skip_next_40dp"
                    app:tint="@color/audix_white"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Volume Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_volume_down"
                    app:tint="@color/audix_text_secondary"
                    android:importantForAccessibility="no" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderVolume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-6dp"
                    android:layout_weight="1"
                    android:value="0.8"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    app:thumbColor="@color/audix_white"
                    app:thumbRadius="5dp"
                    app:trackColorActive="@color/audix_white"
                    app:trackColorInactive="#40FFFFFF"
                    app:trackHeight="3.5dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/audix_text_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
