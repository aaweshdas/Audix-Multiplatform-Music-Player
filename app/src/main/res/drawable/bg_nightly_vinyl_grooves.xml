<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Vinyl Body -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#161B26"
                android:centerColor="#090C12"
                android:endColor="#05070A" />
            <stroke
                android:width="2dp"
                android:color="#243048" />
        </shape>
    </item>

    <!-- Groove Ring 1 -->
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#1A2436" />
        </shape>
    </item>

    <!-- Groove Ring 2 -->
    <item
        android:bottom="40dp"
        android:left="40dp"
        android:right="40dp"
        android:top="40dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#1F2C42" />
        </shape>
    </item>

    <!-- Center Label Glow / Rim -->
    <item
        android:bottom="65dp"
        android:left="65dp"
        android:right="65dp"
        android:top="65dp">
        <shape android:shape="oval">
            <solid android:color="#0D1322" />
            <stroke
                android:width="2.5dp"
                android:color="@color/audix_cyan_bright" />
        </shape>
    </item>
</layer-list>
