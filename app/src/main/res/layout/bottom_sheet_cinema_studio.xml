<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/audix_bg"
    android:orientation="vertical">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/shape_rounded_4dp"
        android:backgroundTint="#334155" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎬 Cinema Studio 4K"
            android:textColor="@color/audix_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/movieCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_audix_badge_cinema"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="331+ TITLES"
            android:textColor="@color/audix_crimson"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:text="Stream Hollywood &amp; global blockbusters, 4K releases, and original motion picture soundtracks."
        android:textColor="@color/audix_text_secondary"
        android:textSize="12sp" />

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:boxBackgroundColor="#0E1626"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/audix_cyan"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search_outline"
        app:startIconTint="@color/audix_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchCinemaInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search blockbusters, series, directors..."
            android:inputType="text"
            android:paddingVertical="8dp"
            android:textColor="@color/audix_white"
            android:textColorHint="@color/audix_text_secondary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Grid of Movies -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCinemaGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_movie_card" />

</LinearLayout>
