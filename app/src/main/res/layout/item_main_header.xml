<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="-20dp"
    android:layout_marginEnd="-20dp"
    android:layout_marginBottom="16dp"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <!-- 1. TOP BRANDING & IDENTITY WORKSTATION BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <!-- Nightly Studio Logo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#131B2E"
            app:cardCornerRadius="12dp"
            app:strokeColor="#22334F"
            app:strokeWidth="1.2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/ic_nightly_logo"
                android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nightly"
                android:textColor="@color/audix_white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.4-UNIFIED • Studio Soundstage"
                android:textColor="@color/audix_cyan_bright"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />
        </LinearLayout>

        <!-- Active Source / Extension Pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/extensionsCont"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#111A2E"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1E2B45"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/extensions"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/extensions"
                    android:src="@drawable/ic_extension_32dp"
                    app:tint="@color/audix_cyan_bright" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="110dp"
                    android:text="Master Collection"
                    android:textColor="@color/audix_white"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings / Account Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/accountsCont"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="#111A2E"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1E2B45"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/accounts"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/extensions"
                android:src="@drawable/ic_settings_outline_32dp"
                app:tint="@color/audix_white" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 2. STUDIO SOUNDSTAGE NOW PLAYING HERO CARD (DESKTOP PARITY) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNowPlayingSoundstage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#0D1324"
        app:cardCornerRadius="20dp"
        app:strokeColor="#243452"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_audix_header_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSoundstageStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_audix_badge_soundstage"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="● STUDIO SOUNDSTAGE"
                    android:textColor="@color/audix_cyan_bright"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_audix_badge_lossless"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="320 KBPS HI-RES"
                    android:textColor="@color/audix_emerald"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/headerGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/audix_text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="Good afternoon" />
            </LinearLayout>

            <!-- Main Soundstage Body: Song Info on Left, Rotating Vinyl on Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Song Info & Mini Transport -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLiveTrackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Nightly Hi-Res Flow"
                        android:textColor="@color/audix_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/tvLiveTrackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Master Collection • Ready to stream"
                        android:textColor="@color/audix_text_secondary"
                        android:textSize="12sp" />

                    <!-- Mini Transport Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Play/Pause Neon Pill -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnLivePlayPause"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="@color/audix_cyan_bright"
                            app:cardCornerRadius="16dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">

                                <ImageView
                                    android:id="@+id/ivLivePlayIcon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_play"
                                    app:tint="#05070D"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:id="@+id/tvLivePlayText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Play Flow"
                                    android:textColor="#05070D"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Open Screensaver Quick Pill -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnLaunchScreensaver"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            app:cardBackgroundColor="#182338"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="#2E3F5E"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📺 Screensaver"
                                    android:textColor="@color/audix_white"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Rotating Vinyl Disc Stage -->
                <FrameLayout
                    android:id="@+id/flLiveVinylContainer"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="14dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_nightly_vinyl_grooves"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="#0D1322"
                        app:cardCornerRadius="17dp"
                        app:strokeColor="@color/audix_cyan_bright"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/ivLiveCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/art_music"
                            android:importantForAccessibility="no" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. STUDIO 4-TILE QUICK ACTION LAUNCHPAD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Tile 1: Screensaver -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tileScreensaver"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#0F1626"
            app:cardCornerRadius="14dp"
            app:strokeColor="#1F2E47"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺 Screensaver"
                    android:textColor="@color/audix_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vinyl &amp; FFT"
                    android:textColor="@color/audix_cyan_bright"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tile 2: Equalizer -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tileEqualizer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#0F1626"
            app:cardCornerRadius="14dp"
            app:strokeColor="#1F2E47"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎚️ Equalizer"
                    android:textColor="@color/audix_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="3D DSP &amp; Bass"
                    android:textColor="@color/audix_emerald"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tile 3: AI Studio -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tileAiStudio"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#0F1626"
            app:cardCornerRadius="14dp"
            app:strokeColor="#1F2E47"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ AI Studio"
                    android:textColor="@color/audix_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Prompt Flow"
                    android:textColor="@color/audix_purple"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tile 4: Cinema Studio -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tileCinemaStudio"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#0F1626"
            app:cardCornerRadius="14dp"
            app:strokeColor="#1F2E47"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 Cinema"
                    android:textColor="@color/audix_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="331+ 4K Films"
                    android:textColor="@color/audix_crimson"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 4. MASTER EXTENSION SOURCE RIBBON -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipMasterCollection"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_audix_badge_soundstage"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="● Master Collection"
                android:textColor="@color/audix_cyan_bright"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipSpotify"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_audix_pill_filter"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Spotify"
                android:textColor="@color/audix_white"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipSaavn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_audix_pill_filter"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="JioSaavn"
                android:textColor="@color/audix_white"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipYoutube"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_audix_pill_filter"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="YouTube Music"
                android:textColor="@color/audix_white"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipSoundCloud"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_audix_pill_filter"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="SoundCloud"
                android:textColor="@color/audix_white"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipRadio"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_audix_pill_filter"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Radio Browser"
                android:textColor="@color/audix_white"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
